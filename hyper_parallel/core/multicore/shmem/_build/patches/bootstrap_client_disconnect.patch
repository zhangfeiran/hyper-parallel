+Result TcpConfigStore::ShutdownCollectively(uint32_t rankSize, int64_t timeoutMs) noexcept
+{
+    if (rankSize == 0 || timeoutMs <= 0) {
+        return SM_INVALID_PARAM;
+    }
+    // A disconnected client has consumed its final barrier response and needs no further server progress.
+    accClientLink_ = nullptr;
+    if (accClient_ != nullptr) {
+        accClient_->Stop();
+        accClient_ = nullptr;
+    }
+    if (accServer_ != nullptr) {
+        return accServer_->WaitForClientsToDisconnect(rankSize, timeoutMs);
+    }
+    return SM_OK;
+}
