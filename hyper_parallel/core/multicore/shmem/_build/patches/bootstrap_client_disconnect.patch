+Result AccStoreServer::WaitForClientsToDisconnect(uint32_t rankSize, int64_t timeoutMs) noexcept
+{
+    if (rankSize == 0 || timeoutMs <= 0) {
+        return SM_INVALID_PARAM;
+    }
+    std::unique_lock<std::mutex> guard(linksMutex_);
+    const bool disconnected = linksClosed_.wait_for(guard, std::chrono::milliseconds(timeoutMs), [&]() {
+        return connectedRanks_.size() == rankSize && activeLinks_.empty();
+    });
+    if (!disconnected) {
+        SHM_LOG_ERROR("Timed out waiting for bootstrap clients to disconnect: expected=" << rankSize
+            << ", connected=" << connectedRanks_.size() << ", active=" << activeLinks_.size());
+        return StoreErrorCode::TIMEOUT;
+    }
     return ACLSHMEM_SUCCESS;
