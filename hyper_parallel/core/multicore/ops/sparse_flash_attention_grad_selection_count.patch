 template <typename SFAGT>
+__aicore__ inline int32_t SelectedAttentionGradBasic<SFAGT>::ValidSelectedCount(
+    const int64_t t1Idx, const int64_t n2Idx, int32_t limit)
+{
+    const int64_t base = t1Idx * (dimN2 * selectedBlockCount) + n2Idx * selectedBlockCount;
+    if (limit <= 0 || topkIndicesGm.GetValue(base + limit - 1) >= 0) {
+        return limit;
+    }
+    int32_t begin = 0;
+    int32_t end = limit;
+    while (begin < end) {
+        const int32_t mid = begin + (end - begin) / 2;
+        if (topkIndicesGm.GetValue(base + mid) >= 0) {
+            begin = mid + 1;
+        } else {
+            end = mid;
+        }
+    }
+    return begin;
+}
