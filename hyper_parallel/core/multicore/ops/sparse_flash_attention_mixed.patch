+// This callable path has no global initializer or flash-decode reduction.
+ge::graphStatus TilingHyperDsaMixedTile(gert::TilingContext *context)
+{
+    auto attrs = context->GetAttrs();
+    if (attrs == nullptr || context->GetInputDesc(0) == nullptr ||
+        context->GetInputDesc(0)->GetDataType() != ge::DT_BF16) {
+        return ge::GRAPH_FAILED;
+    }
+    const auto *qLayout = attrs->GetAttrPointer<char>(LAYOUT_QUERY_ATTR_INDEX);
+    const auto *kvLayout = attrs->GetAttrPointer<char>(LAYOUT_KV_ATTR_INDEX);
+    const auto *blockSize = attrs->GetAttrPointer<int64_t>(SPARSE_BLOCK_SIZE_ATTR_INDEX);
+    const auto *mode = attrs->GetAttrPointer<int64_t>(SPARSE_MODE_ATTR_INDEX);
+    if (qLayout == nullptr || kvLayout == nullptr || blockSize == nullptr || mode == nullptr ||
+        std::string(qLayout) != "TND" || std::string(kvLayout) != "TND" || *blockSize != 1 || *mode != 3) {
+        return ge::GRAPH_FAILED;
+    }
+    const auto *config = context->GetRequiredInputShape(9);
+    const auto *trace = context->GetRequiredInputShape(10);
+    // CANN coalesces integer buffer axes; the Torch bridge checks logical shape and independent contiguous storage.
+    if (config == nullptr || trace == nullptr || config->GetStorageShape().GetShapeSize() != 4 ||
+        config->GetStorageShape().GetDimNum() != 1 || trace->GetStorageShape().GetShapeSize() != 1280) {
+        return ge::GRAPH_FAILED;
+    }
+    platform_ascendc::PlatformAscendC platform(context->GetPlatformInfo());
+    if (platform.GetCoreNumAic() != 20 || platform.GetCoreNumAiv() != 40) {
+        return ge::GRAPH_FAILED;
+    }
+    return TilingSparseFlashAttention(context);
+}
+
