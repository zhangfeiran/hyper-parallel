+def _allocate_packed_gradients(first: Any, second: Any) -> tuple[Any, tuple[Any, Any]]:
+    """Allocate disjoint dense FP32 matrix views backed by one exact-size buffer."""
+    split = first.numel()
+    packed = torch.empty(split + second.numel(), dtype=torch.float32, device=first.device)
+    matrices = (packed[:split].view(first.shape), packed[split:].view(second.shape))
+    return packed, matrices
+
+
+def _pack_gradient_pair(first: Any, second: Any) -> Any:
+    """Expose adjacent FP32 views without copying, materializing external layouts only."""
+    contiguous = first.is_contiguous() and second.is_contiguous()
+    same_storage = (
+        first.device == second.device
+        and first.untyped_storage().data_ptr() == second.untyped_storage().data_ptr()
+    )
+    adjacent = first.storage_offset() + first.numel() == second.storage_offset()
+    if contiguous and same_storage and adjacent:
+        return first.as_strided((first.numel() + second.numel(),), (1,))
+    return torch.cat((first.reshape(-1), second.reshape(-1)))
+
+
