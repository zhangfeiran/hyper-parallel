+    def test_packed_shared_receives_wait_before_fp32_owner_accumulation(self) -> None:
+        """
+        Feature: paired FP32 gradient return
+        Description: receive packed contributions from two replicas into disjoint matrix views
+        Expectation: one descriptor per peer, no duplicated storage, and accumulation only after wait
+        """
+        manager = ExpertReplicaManager(replace(self._config(rank_id=0), ep_size=3, num_experts=6))
+        plan = build_constrained_expert_placement(((9, 0, 0, 0, 0, 0),) * 3, 1, receive_capacity=9)
+        home_partials = (torch.full((2, 2, 2), 7.0), torch.full((2, 1, 2), 7.0))
+        for home in home_partials:
+            home[0].fill_(256)
+        replicas = tuple(torch.zeros_like(home[:1]) for home in home_partials)
+        transfers, received = manager._gradient_transfers(plan, *home_partials, replica_gradients=replicas)
+        self.assertEqual(len(transfers), 2)
+        for transfer, (slot, first, second) in zip(transfers, received):
+            self.assertEqual(slot, 0)
+            self.assertEqual(transfer.operation, "receive")
+            self.assertEqual(transfer.tensor.dtype, torch.float32)
+            self.assertEqual(transfer.tensor.numel(), 6)
+            self.assertEqual(first.data_ptr(), transfer.tensor.data_ptr())
+            self.assertEqual(second.data_ptr(), first.data_ptr() + first.numel() * 4)
+            self.assertEqual(first.untyped_storage().nbytes(), 24)
+            self.assertEqual(first.untyped_storage().data_ptr(), second.untyped_storage().data_ptr())
+
+        def launch(batch: tuple, _group: Any) -> tuple:
+            """Fill receives only when the caller actually waits for completion."""
+            def wait() -> None:
+                """Complete both peer contributions before owner accumulation."""
+                for home in home_partials:
+                    torch.testing.assert_close(home[0], torch.full_like(home[0], 256), rtol=0, atol=0)
+                for transfer in batch:
+                    transfer.tensor.fill_(1 if transfer.peer_rank == 1 else -256)
+            return (SimpleNamespace(wait=wait),)
+
+        with patch.object(replica_module, "_launch_transfers", side_effect=launch):
+            result = manager.reduce_replica_gradients(plan, *home_partials, replica_gradients=replicas)
+        for actual, home in zip(result, home_partials):
+            torch.testing.assert_close(actual[0], torch.ones_like(actual[0]), rtol=0, atol=0)
+            torch.testing.assert_close(actual[1], torch.full_like(actual[1], 7), rtol=0, atol=0)
+            self.assertEqual(actual.dtype, torch.float32)
+            self.assertEqual(actual.data_ptr(), home.data_ptr())
+
+    def test_external_single_slot_gradients_pack_without_changing_values(self) -> None:
+        """
+        Feature: deterministic paired wire protocol
+        Description: pass nonadjacent and noncontiguous external single-slot gradients
+        Expectation: materialize a packed send with unchanged values and unchanged input storage
+        """
+        manager = ExpertReplicaManager(self._config(rank_id=1))
+        plan = self._hot_expert_zero_plan()
+        replicas = (torch.arange(4, dtype=torch.float32).reshape(1, 2, 2).transpose(1, 2),
+                    torch.tensor([[[8.0, 9.0]]]))
+        home_partials = (torch.zeros(2, 2, 2), torch.zeros(2, 1, 2))
+        expected = torch.cat([gradient.reshape(-1) for gradient in replicas])
+        transfers, received = manager._gradient_transfers(plan, *home_partials, replica_gradients=replicas)
+        self.assertEqual(received, ())
+        self.assertEqual(len(transfers), 1)
+        torch.testing.assert_close(transfers[0].tensor, expected, rtol=0, atol=0)
+        self.assertNotIn(transfers[0].tensor.data_ptr(), [gradient.data_ptr() for gradient in replicas])
+        torch.testing.assert_close(torch.cat([gradient.reshape(-1) for gradient in replicas]), expected, rtol=0, atol=0)
+
+    def test_multiple_slots_keep_separate_dense_matrix_pools(self) -> None:
+        """
+        Feature: multi-slot gradient compatibility
+        Description: prepare two slots whose gate/up and down rows are not adjacent per expert
+        Expectation: preserve dense matrix layout and the separate descriptor protocol
+        """
+        manager = ExpertReplicaManager(replace(self._config(rank_id=1), replica_slots_per_rank=2))
+        plan = build_constrained_expert_placement(((4, 0, 0, 0),) * 2, 2, receive_capacity=4)
+        weights = (torch.ones(2, 2, 2, dtype=torch.bfloat16), torch.ones(2, 1, 2, dtype=torch.bfloat16))
+        home_partials = tuple(torch.ones_like(weight, dtype=torch.float32) for weight in weights)
+        with patch.object(replica_module, "_launch_transfers", return_value=()):
+            lease = manager.start_shared_prefetch(*weights, plan)
+            gradients = lease.prepare_backward(multi_wave=True)
+            self.assertNotEqual(gradients[0].untyped_storage().data_ptr(), gradients[1].untyped_storage().data_ptr())
+            for gradient, weight in zip(gradients, weights):
+                self.assertEqual(gradient.shape, weight.shape)
+                self.assertTrue(gradient.is_contiguous())
+                self.assertEqual(gradient.untyped_storage().nbytes(), gradient.numel() * 4)
+            transfers, _ = manager._gradient_transfers(plan, *home_partials, replica_gradients=gradients)
+            self.assertEqual(len(transfers), 2)
+            self.assertEqual([transfer.tensor.data_ptr() for transfer in transfers],
+                             [gradient.data_ptr() for gradient in gradients])
+            lease.release()
+
